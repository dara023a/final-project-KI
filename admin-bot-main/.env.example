# =====================================================
# SAFETY-BOT ENVIRONMENT VARIABLES
# =====================================================
# Salin file ini menjadi .env lalu isi nilainya
# JANGAN pernah commit file .env ke git!

# Endpoint & model Ollama (LLM lokal)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b

# Mode moderasi: baseline | gated | llm
#   baseline : hanya blocklist + regex (tanpa LLM, untuk pembanding eksperimen)
#   gated    : LLM hanya dipanggil jika blocklist/regex kena
#   llm      : semua pesan non-trivial dikirim ke LLM
MODERATION_MODE=llm

# Nomor WhatsApp (format 62..., tanpa awalan 0)
OWNER_NUMBER=628xxxxxxxxxx
BOT_NUMBER=628xxxxxxxxxx

# Timezone
TZ=Asia/Jakarta
