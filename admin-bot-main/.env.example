# =====================================================
# SECURITY-BOT ENVIRONMENT VARIABLES — TEMPLATE
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN pernah commit file .env!
# =====================================================

# ─── Identitas bot ────────────────────────────────────
BOT_NAME=Security-Bot

# ─── LLM lokal (Ollama) ───────────────────────────────
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_MS=60000
LLM_CONFIDENCE=0.75

# ─── ML service (TF-IDF + Logistic Regression) ────────
# Jalankan `python ml_service.py` di root proyek.
ML_URL=http://127.0.0.1:5001/predict
ML_CONFIDENCE=0.65
ML_SAFE_CONFIDENCE=0.85
ML_TIMEOUT_MS=2500
ML_RETRY_MS=30000

# ─── Mode pipeline keamanan ───────────────────────────
#   rules  : heuristik lokal saja (baseline)
#   ml     : rules + model ML, tanpa LLM
#   llm    : rules + LLM, tanpa ML
#   hybrid : rules + ML + LLM untuk kasus ambigu (disarankan)
SECURITY_MODE=hybrid

# ─── Ambang aturan lokal ──────────────────────────────
RULE_THRESHOLD=0.60
RULE_STRONG=0.80

# ─── Analisis URL phishing ────────────────────────────
# Aktifkan hanya jika ingin memperluas shortener via HTTP.
PHISHING_EXPAND_SHORTENERS=false
PHISHING_TIMEOUT_MS=2500

# ─── Notifikasi & insiden ─────────────────────────────
NOTIFY_OWNER_ON_THREAT=true
INCIDENT_MAX=500

# ─── Nomor WhatsApp (format 62..., tanpa awalan 0) ────
OWNER_NUMBER=628xxxxxxxxxx
BOT_NUMBER=628xxxxxxxxxx

# ─── Browser / WhatsApp session ───────────────────────
# Kosongkan CHROME_PATH untuk memakai Chromium bawaan Puppeteer.
# Windows contoh: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
HEADLESS=true
WA_CLIENT_ID=safety-bot

# ─── Timezone & dashboard ─────────────────────────────
TZ=Asia/Jakarta
PORT=7860
